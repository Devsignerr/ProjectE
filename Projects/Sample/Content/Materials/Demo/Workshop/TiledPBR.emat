  "Graph": {
    "Nodes": [
      {
        "Id": "uv0",
        "Type": "TexCoord"
      },
      {
        "Id": "tiling",
        "Type": "VectorParameter",
        "Parameter": "Tiling"
      },
      {
        "Id": "tilingXY",
        "Type": "Append",
        "Inputs": {
          "A": "tiling:2",
          "B": "tiling:3"
        }
      },
      {
        "Id": "uv",
