{
  "Version": 1,
  "Struct": "Data/FarmBie/Item.estruct",
  "Rows": [
    {
      "Name": "Hoe",
      "Values": {
        "DisplayName": "괭이",
        "Kind": "Tool",
        "Price": 0,
        "Description": "풀밭을 갈아 밭을 만든다. 시든 작물도 걷어낸다."
      }
    },
    {
      "Name": "Can",
      "Values": {
        "DisplayName": "물뿌리개",
        "Kind": "Tool",
        "Price": 0,
        "Description": "작물에 물을 준다. 물이 떨어지면 우물에서 채운다."
      }
    },
    {
      "Name": "FertBasic",
      "Values": {
        "DisplayName": "기본 비료",
        "Kind": "Fertilizer",
        "Price": 20,
        "Description": "간 칸에 뿌리면 그 칸 작물의 희귀 씨앗 확률이 오른다."
      }
    },
    {
      "Name": "FertPremium",
      "Values": {
        "DisplayName": "고급 비료",
        "Kind": "Fertilizer",
        "Price": 60,
        "Description": "희귀 씨앗 확률이 크게 오른다. 보부상이 가끔 들고 온다."
      }
    },
    {
      "Name": "Axe",
      "Values": {
        "DisplayName": "도끼",
        "Kind": "Tool",
        "Price": 0,
        "Description": "숲의 나무를 벤다. 밤에는 무기로도 쓸 수 있다."
      }
    },
    {
      "Name": "Pick",
      "Values": {
        "DisplayName": "곡괭이",
        "Kind": "Tool",
        "Price": 0,
        "Description": "바위를 깨 돌을 얻는다."
      }
    },
    {
      "Name": "Wood",
      "Values": {
        "DisplayName": "나무",
        "Kind": "Material",
        "Price": 0,
        "Description": "숲에서 벤 통나무. 울타리와 건물의 기본 재료."
      }
    },
    {
      "Name": "Stone",
      "Values": {
        "DisplayName": "돌",
        "Kind": "Material",
        "Price": 0,
        "Description": "단단한 돌. 돌벽과 덫에 쓴다."
      }
    },
    {
      "Name": "Fiber",
      "Values": {
        "DisplayName": "섬유",
        "Kind": "Material",
        "Price": 0,
        "Description": "질긴 풀 줄기. 덫·밧줄·붕대의 재료."
      }
    },
    {
      "Name": "Herb",
      "Values": {
        "DisplayName": "약초",
        "Kind": "Food",
        "Price": 0,
        "Health": 20,
        "Sanity": 0,
        "Description": "쓴맛이 나는 숲 약초. 먹으면 상처가 아문다."
      }
    },
    {
      "Name": "Mushroom",
      "Values": {
        "DisplayName": "몽롱버섯",
        "Kind": "Food",
        "Price": 0,
        "Health": 4,
        "Sanity": 8,
        "Description": "보랏빛 갓의 버섯. 먹으면 머릿속이 조금 고요해진다."
      }
    },
    {
      "Name": "Iron",
      "Values": {
        "DisplayName": "철",
        "Kind": "Material",
        "Price": 45,
        "Description": "제련한 쇳덩이. 철벽과 포탑에 쓴다. 보부상이나 탑에서 얻는다."
      }
    },
    {
      "Name": "CrystalShard",
      "Values": {
        "DisplayName": "크리스탈 조각",
        "Kind": "Material",
        "Price": 220,
        "Description": "보랏빛으로 맥동하는 조각. 크리스탈을 강화한다. 탑 깊은 곳에 많다."
      }
    },
    {
      "Name": "Mine",
      "Values": {
        "DisplayName": "지뢰",
        "Kind": "Trap",
        "Price": 60,
        "Description": "밟은 좀비 둘레를 날려 버린다. 한 번 쓰면 사라진다. (건설 모드에서 설치)"
      }
    },
    {
      "Name": "Sword",
      "Values": {
        "DisplayName": "농부의 검",
        "Kind": "Weapon",
        "Price": 450,
        "Description": "날이 선 한손검. 넓게 베어 여러 좀비를 밀어낸다."
      }
    },
    {
      "Name": "Bow",
      "Values": {
        "DisplayName": "사냥 활",
        "Kind": "Weapon",
        "Price": 600,
        "Description": "멀리서 화살을 쏜다. 화살이 필요하다 (작업대에서 제작)."
      }
    },
    {
      "Name": "Shotgun",
      "Values": {
        "DisplayName": "산탄총",
        "Kind": "Weapon",
        "Price": 1600,
        "Description": "가까운 좀비 무리를 한 번에 날린다. 산탄이 필요하다."
      }
    },
    {
      "Name": "Arrow",
      "Values": {
        "DisplayName": "화살",
        "Kind": "Ammo",
        "Price": 3,
        "Description": "활에 쓴다."
      }
    },
    {
      "Name": "Shell",
      "Values": {
        "DisplayName": "산탄",
        "Kind": "Ammo",
        "Price": 12,
        "Description": "산탄총에 쓴다."
      }
    },
    {
      "Name": "EyeArrow",
      "Values": {
        "DisplayName": "눈알 화살",
        "Kind": "Ammo",
        "Price": 0,
        "Description": "레어 눈알무로 촉을 단 화살. 약점을 노려 피해가 크다."
      }
    },
    {
      "Name": "FireArrow",
      "Values": {
        "DisplayName": "불화살",
        "Kind": "Ammo",
        "Price": 0,
        "Description": "레어 혈관고추 즙을 바른 화살. 아주 뜨겁다."
      }
    },
    {
      "Name": "GhostShell",
      "Values": {
        "DisplayName": "유령 산탄",
        "Kind": "Ammo",
        "Price": 0,
        "Description": "레어 유령마늘 가루를 채운 산탄. 언데드에게 잘 듣는다."
      }
    },
    {
      "Name": "SkullMine",
      "Values": {
        "DisplayName": "해골 지뢰",
        "Kind": "Trap",
        "Price": 0,
        "Description": "레어 해골수박을 터뜨리는 지뢰. 아주 넓게 폭발한다."
      }
    },
    {
      "Name": "ScreamMine",
      "Values": {
        "DisplayName": "비명 지뢰",
        "Kind": "Trap",
        "Price": 0,
        "Description": "레어 비명호박 속을 채운 지뢰. 소리와 함께 크게 터진다."
      }
    },
    {
      "Name": "FangSpike",
      "Values": {
        "DisplayName": "이빨 덫",
        "Kind": "Trap",
        "Price": 0,
        "Description": "레어 이빨옥수수 송곳니를 박은 덫. 가시덫보다 훨씬 아프다."
      }
    }
  ]
}
