    {
      "Name": "Merchant",
      "Values": {
        "DisplayName": "상인 미라",
        "Flipbook": "Sprites/HD2D/Npc_Merchant.eflipbook",
        "Role": "Shop",
        "Lines": [
          "어서 오세요, 여행자님! 들판으로 나가신다면 준비는 단단히 하셔야죠.",
          "회복약부터 활과 갑옷까지, 필요한 건 다 있답니다."
        ],
        "Portrait": "UI/Demo/HD2D/Portraits/Merchant.png",
        "SubQuest": "",
