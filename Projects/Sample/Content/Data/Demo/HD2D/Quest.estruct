{
  "Version": 1,
  "Name": "Quest",
  "Description": "HD2D 퀘스트 단계 (Quests.etable, 행 이름 = Stage<n>, 촌장에게 말하면 다음 단계로)",
  "Fields": [
    {
      "Name": "Title",
      "Type": "String",
      "Default": "",
      "Description": "퀘스트 이름"
    },
    {
      "Name": "Objective",
      "Type": "String",
      "Default": "",
      "Description": "목표 표시"
    },
    {
      "Name": "KillGoal",
      "Type": "Int",
      "Default": 0,
      "Description": "> 0이면 마물 처치 수가 이만큼 되면 다음 단계"
    },
    {
      "Name": "Lines",
      "Type": "Array",
      "Default": [],
      "Description": "이 단계로 넘어갈 때 촌장 대사",
      "Element": "String"
    },
    {
      "Name": "WaitLines",
      "Type": "Array",
      "Default": [],
      "Description": "이 단계에서 아직 넘어갈 수 없을 때 촌장 대사",
      "Element": "String"
    },
    {
      "Name": "AdvanceOnTalk",
      "Type": "Bool",
      "Default": false,
      "Description": "촌장에게 말하면 다음 단계로 (보고 단계)"
    },
    {
      "Name": "BossGoal",
      "Type": "String",
      "Default": "",
      "Description": "이 맵 id의 보스를 쓰러뜨리면 다음 단계로 (Village / Cave)"
    },
    {
      "Name": "NewGoal",
      "Type": "Bool",
      "Default": false,
      "Description": "이 단계로 넘어갈 때 \"새 목표\" 알림"
    },
    {
      "Name": "RewardGold",
      "Type": "Int",
      "Default": 0,
      "Description": "이 단계로 넘어갈 때 보상 골드 (앞 단계 완료 보상 — \"퀘스트 완료!\" 알림)"
    },
    {
      "Name": "RewardItem",
      "Type": "String",
      "Default": "",
      "Description": "보상 아이템"
    },
    {
      "Name": "Ending",
      "Type": "Bool",
      "Default": false,
      "Description": "이 단계로 넘어가면 엔딩·크레딧 (Balance.EndingPages)"
    }
  ]
}
