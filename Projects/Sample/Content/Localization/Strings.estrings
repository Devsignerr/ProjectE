    "Showcase.Zone.Intro.Desc": {
      "en": "Terrain · foliage · HDR sky · height & volumetric fog",
      "ko": "지형 · 폴리지 · HDR 하늘 · 높이/볼류메트릭 안개"
    },
    "Showcase.Zone.Character": {
      "en": "Character & Animation",
      "ko": "캐릭터 & 애니메이션"
    },
    "Showcase.Zone.Character.Desc": {
      "en": "Anim graph · 2D blend · montage · foot IK (steps/slope) · look-at IK",
      "ko": "애니메이션 그래프 · 2D 블렌드 · 몽타주 · 발 IK(계단/경사) · 시선 IK"
    },
