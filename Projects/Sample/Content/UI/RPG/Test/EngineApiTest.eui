{
  "Version": 2,
  "DesignSize": [1920, 1080],
  "ScaleMode": "MatchHeight",
  "Root": {
    "Type": "Canvas",
    "Name": "Root",
    "Visibility": "SelfHitTestInvisible",
    "Children": [
      {
        "Type": "Text",
        "Name": "Title",
        "Visibility": "HitTestInvisible",
        "Slot": { "AnchorMin": [0, 0], "AnchorMax": [0, 0], "Offsets": [32, 24, 900, 40], "Alignment": [0, 0], "AutoSize": true },
        "Text": "Camera.WorldToScreen / CloneWidget 검증",
        "FontSize": 30,
        "TextColor": [1, 1, 1, 1],
        "OutlineWidth": 2,
        "OutlineColor": [0, 0, 0, 1]
      },
      {
        "Type": "Border",
        "Name": "LabelTemplate",
        "Visibility": "Collapsed",
        "Slot": { "AnchorMin": [0, 0], "AnchorMax": [0, 0], "Offsets": [0, 0, 170, 56], "Alignment": [0.5, 1], "AutoSize": false },
        "Brush": { "Color": [0.04, 0.05, 0.08, 0.8], "CornerRadius": 8, "BorderWidth": 1, "BorderColor": [1, 1, 1, 0.25] },
        "ContentPadding": [10, 6, 10, 8],
        "Children": [
          {
            "Type": "VerticalBox",
            "Name": "Box",
            "Visibility": "SelfHitTestInvisible",
            "Slot": { "Padding": [0, 0, 0, 0], "HAlign": "Fill", "VAlign": "Fill" },
            "Children": [
              {
                "Type": "Text",
                "Name": "Name",
                "Visibility": "HitTestInvisible",
                "Slot": { "Padding": [0, 0, 0, 4], "HAlign": "Center", "VAlign": "Fill", "SizeRule": "Auto" },
                "Text": "이름",
                "FontSize": 20,
                "TextColor": [1, 0.95, 0.8, 1]
              },
              {
                "Type": "ProgressBar",
                "Name": "Hp",
                "Visibility": "HitTestInvisible",
                "MinSize": [100, 10],
                "Slot": { "Padding": [0, 0, 0, 0], "HAlign": "Fill", "VAlign": "Fill", "SizeRule": "Fill", "FillWeight": 1 },
                "Brush": { "Color": [0.02, 0.02, 0.03, 0.9], "CornerRadius": 4 },
                "FillBrush": { "Color": [0.85, 0.2, 0.2, 1], "CornerRadius": 4 },
                "Percent": 1,
                "FillDirection": "LeftToRight"
              }
            ]
          }
        ]
      },
      {
        "Type": "Border",
        "Name": "DotTemplate",
        "Visibility": "Collapsed",
        "Slot": { "AnchorMin": [0, 0], "AnchorMax": [0, 0], "Offsets": [0, 0, 8, 8], "Alignment": [0.5, 0.5], "AutoSize": false },
        "Brush": { "Color": [0.2, 1, 0.4, 1], "CornerRadius": 4, "BorderWidth": 1, "BorderColor": [0, 0, 0, 1] }
      }
    ]
  }
}
