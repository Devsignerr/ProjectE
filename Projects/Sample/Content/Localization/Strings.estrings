      "en": "AI Guard",
      "ko": "AI 경비"
    },
    "Showcase.Zone.AI.Desc": {
      "en": "Behavior tree patrol · Recast navmesh · chases you when you get close",
      "ko": "비헤이비어 트리 순찰 · Recast 내비메시 · 가까이 가면 쫓아온다"
    },
    "Showcase.Zone.Physics": {
      "en": "Physics",
      "ko": "물리"
    },
    "Showcase.Zone.Physics.Desc": {
      "en": "Jolt rigid bodies · joints (hinge/chain/spring/motor) · ragdolls · triggers · overlap debug draw",
      "ko": "Jolt 강체 · 관절(경첩/사슬/스프링/모터) · 래그돌 · 트리거 · 겹침 검사 디버그 선"
    },
    "Showcase.Zone.Campfire": {
      "en": "Campfire",
      "ko": "모닥불"
    },
    "Showcase.Zone.Campfire.Desc": {
      "en": "Particles (fire · smoke · sparks) · flickering shadowed point light · 3D audio",
      "ko": "파티클(불꽃 · 연기 · 불티) · 깜빡이는 그림자 점광원 · 3D 사운드"
    },
    "Showcase.Zone.Materials": {
      "en": "Materials & Reflections",
      "ko": "머티리얼 & 반사"
    },
    "Showcase.Zone.Materials.Desc": {
      "en": "PBR helmet · chrome · glass/stained glass · masked leaves · emissive · reflection capture + SSR",
