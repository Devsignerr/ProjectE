    },
    "Showcase.Zone.Lights": {
      "en": "Lights · Fog · Decals",
      "ko": "조명 · 안개 · 데칼"
    },
    "Showcase.Zone.Lights.Desc": {
      "en": "Shadowed spot/point lights · volumetric light shafts · decals (puddles · rivets · arrows)",
      "ko": "그림자 스포트/점광원 · 볼류메트릭 빛줄기 · 데칼(웅덩이 · 리벳 · 화살표)"
    },
    "Showcase.Zone.Plaza": {
      "en": "The Plaza — Your Turn",
      "ko": "광장 — 직접 둘러보기"
    },
    "Showcase.Zone.Plaza.Desc": {
      "en": "Prefab lamp posts · localized HUD · walk the fox around the zones",
      "ko": "프리팹 가로등 · 다국어 HUD · 여우를 움직여 구역을 돌아보세요"
    },
    "Showcase.Hint.Tour": {
      "en": "Space / Enter: skip the tour    ·    L: switch language",
